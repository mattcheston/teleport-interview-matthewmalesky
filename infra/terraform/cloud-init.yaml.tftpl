#cloud-config
# Node preparation for kubeadm. Identical on the control plane and the
# workers; kubeadm init/join is run afterwards by scripts/kubeadm-up.sh.
# Rendered by Terraform (infra/terraform/main.tf). Progress is logged to
# /var/log/cloud-init-output.log on the node.

package_update: true
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gpg
  - containerd

write_files:
  - path: /etc/modules-load.d/kubernetes.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/99-kubernetes.conf
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1

runcmd:
  - - bash
    - -c
    - |
      set -euxo pipefail
      export DEBIAN_FRONTEND=noninteractive
      APT='apt-get -o DPkg::Lock::Timeout=300'

      # Kernel prerequisites; no swap.
      modprobe overlay
      modprobe br_netfilter
      sysctl --system
      swapoff -a
      sed -i '/\sswap\s/s/^/#/' /etc/fstab

      # kubeadm, kubelet, kubectl from the official repo for one minor version.
      mkdir -p -m 755 /etc/apt/keyrings
      curl -fsSL "https://pkgs.k8s.io/core:/stable:/v${kubernetes_minor}/deb/Release.key" \
        | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
      echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v${kubernetes_minor}/deb/ /" \
        > /etc/apt/sources.list.d/kubernetes.list
      $APT update
      $APT install -y kubelet kubeadm kubectl
      apt-mark hold kubelet kubeadm kubectl

      # containerd: systemd cgroup driver, and the pause image this kubeadm expects.
      mkdir -p /etc/containerd
      containerd config default > /etc/containerd/config.toml
      sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
      PAUSE=$(kubeadm config images list 2>/dev/null | grep '/pause:')
      sed -i "s|sandbox_image = .*|sandbox_image = \"$PAUSE\"|" /etc/containerd/config.toml
      systemctl enable containerd
      systemctl restart containerd

      # kubelet: hand node lifecycle to the DigitalOcean cloud controller manager,
      # and register with the VPC address rather than the public one.
      PRIVATE_IP=$(curl -fsS http://169.254.169.254/metadata/v1/interfaces/private/0/ipv4/address)
      echo "KUBELET_EXTRA_ARGS=--cloud-provider=external --node-ip=$PRIVATE_IP" > /etc/default/kubelet
      systemctl enable kubelet

      # Pre-pull so kubeadm init/join is quick.
      kubeadm config images pull || true

      touch /var/lib/kubeadm-node-ready
